{
  "name": "@keys-i/seer",
  "version": "0.1.0",
  "description": "Build-time localization, JSON content, SEO, and AI-search metadata for any website.",
  "type": "module",
  "license": "MIT",
  "author": "keys-i",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keys-i/seer.git"
  },
  "bugs": {
    "url": "https://github.com/keys-i/seer/issues"
  },
  "keywords": [
    "i18n",
    "localization",
    "seo",
    "json",
    "static-site"
  ],
  "engines": {
    "node": ">=24.18.0"
  },
  "sideEffects": false,
  "files": [
    "dist/src"
  ],
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "seer": "./dist/src/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=90 dist/test/*.test.js",
    "benchmark": "npm run build && node dist/test/seer.bench.js",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "ci": "npm run coverage && node dist/test/seer.bench.js && node scripts/package-smoke.mjs && npm audit",
    "prepublishOnly": "npm run ci"
  },
  "dependencies": {
    "smol-toml": "1.7.1"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
